@model school.Models.Register

@{
    ViewData["Title"] = "Edit";
}

<div class="studentEdit">
<h1>Update Student Enrollment</h1>
</div>

<hr />
<div class="row">
    <div class="editForm">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="editInput">
                <label asp-for="StudentId" class="control-label"></label>
                <input asp-for="StudentId" class="form-control" />
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="editInput">
                <label asp-for="Student" class="control-label"></label>
                <input asp-for="Student" class="form-control" />
                <span asp-validation-for="Student" class="text-danger"></span>
            </div>

            <div class="editInput">
                <label asp-for="CourseId" class="control-label"></label>
                <input asp-for="CourseId" class="form-control" />
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>

            <div class="editInput">
                <label asp-for="Course" class="control-label"></label>
                <input asp-for="Course" class="form-control" />
                <span asp-validation-for="Course" class="text-danger"></span>
            </div>

            <div class="editInput">
                <label asp-for="Grade" class="control-label"></label>
                <input asp-for="Grade" class="form-control" />
                <span asp-validation-for="Grade" class="text-danger"></span>
            </div>
            <div class="editBtn">
            <div >
                <input type="submit" value="Save" class="saveBtn" />
            </div>
            <div>
               <a asp-action="Index" style="display: flex; justify-content: center; align-items: center; text-decoration: none; color:#524646; background-color:#E3F2FD; width: 100px; height: 35px; border-radius: 5px; font-size: 20px;">Back </a>
             </div>
             </div>

        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
