@model school.ViewModels.RegistrationViewModel

@{
    ViewData["Title"] = "Create Registration";
}
<div class="studentRegister">
<h1>Create new Enrollment</h1>
</div>
<hr />
<div class="row">
    <div class="registerForm">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- 1. Student Selection Dropdown -->
            <div class="selectStudent">
                <label asp-for="StudentId" class="control-label">Select Student</label>
                <select asp-for="StudentId" asp-items="Model.StudentOptions" class="form-select form-control">
                    <option value="">Choose a Student</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <!-- 2. Course Selection Dropdown -->
            <div class="selectCourse">
                <label asp-for="CourseId" class="control-label">Select Course</label>
                <select asp-for="CourseId" asp-items="Model.CourseOptions" class="form-select form-control">
                    <option value="">Choose a Course</option>
                </select>
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>

            <!-- 3. Grade Entry Field -->
            <div class="addGrade">
                <label asp-for="Grade" class="control-label">Grade</label>
                <input asp-for="Grade" class="form-control" type="text" min="0" max="100" placeholder="Grade A-F" />
                <span asp-validation-for="Grade" class="text-danger"></span>
            </div>
            <div class="containBtn">
                <div class="">
                    <a asp-action="Index" style="display: flex; justify-content: center; align-items: center; text-decoration: none; color:#524646; background-color:#E3F2FD; width: 100px; height: 40px; border-radius: 5px; font-size: 20px;">Back</a>
                </div>

            <div class="form-group">
                <input type="submit" value="Register" class="createBtn" />
            </div>
           
            </div>
        </form>
    </div>
</div>


