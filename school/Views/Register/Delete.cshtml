@model school.DTOs.RegistrationDto

@{
    ViewData["Title"] = "Delete";
}

<div class="deleteStudent">
    <h3>Are you sure you want to delete this?</h3>
</div>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Student ID
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StudentId)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Student Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StudentName)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Course Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CourseName)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Grade
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Grade)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <!-- Hidden input bound directly to the DTO's Id property -->
        <input type="hidden" asp-for="Id" />
        
        <div class="deleteBtn">
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index" style="display: flex; justify-content: center; align-items: center; text-decoration: none; color:black; background-color:#E3F2FD; width: 100px; height: 35px; border-radius: 5px; font-size: 20px;">Back</a>
        </div>
    </form>
</div>
