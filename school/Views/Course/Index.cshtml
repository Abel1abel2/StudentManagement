@model IEnumerable<school.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="container my-5" style="max-width: 1000px; font-family: 'Segoe UI', system-ui, sans-serif;">
    <!-- Top Header & Action Row -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold text-dark m-0" style="letter-spacing: -0.5px;">Course Catalog</h1>
            <p class="text-muted small m-0 mt-1">Manage, update, and track curriculum courses.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="border-radius: 8px; box-shadow: 0 4px 12px rgba(13, 110, 253, 0.15);">
            <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
            </svg>
            Add Course
        </a>
    </div>

    <!-- Table Card Component -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden; background: #ffffff; border: 1px solid rgba(0,0,0,0.05) !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light text-secondary" style="font-size: 0.75rem; letter-spacing: 0.5px; text-transform: uppercase;">
                    <tr>
                        <th class="ps-4 py-3" style="width: 50%;">@Html.DisplayNameFor(model => model.CourseName)</th>
                        <th class="py-3" style="width: 25%;">@Html.DisplayNameFor(model => model.CreditHours)</th>
                        <th class="pe-4 py-3 text-end" style="width: 25%;">Actions</th>
                    </tr>
                </thead>
                <tbody style="font-size: 0.9rem;">
                    @foreach (var item in Model) {
                        <tr>
                            <!-- Course Name -->
                            <td class="ps-4 py-3 fw-semibold text-dark">
                                @Html.DisplayFor(model => item.CourseName)
                            </td>
                            
                            <!-- Badged Credit Hours -->
                            <td class="py-3">
                                <span class="badge px-3 py-2 fw-medium text-success bg-success bg-opacity-10" style="border-radius: 30px; font-size: 0.8rem;">
                                    @Html.DisplayFor(model => item.CreditHours) Credits
                                </span>
                            </td>
                            
                            <!-- Action Buttons -->
                            <td class="pe-4 py-3 text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-primary border-0 px-3 py-1.5" style="border-radius: 6px; font-size: 0.85rem; font-weight: 500;">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-secondary border-0 px-3 py-1.5" style="border-radius: 6px; font-size: 0.85rem; font-weight: 500;">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-danger border-0 px-3 py-1.5" style="border-radius: 6px; font-size: 0.85rem; font-weight: 500;">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Empty State Alert -->
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <p class="m-0 fs-5">No courses cataloged</p>
                <small>Click "Add Course" to populate the list.</small>
            </div>
        }
    </div>
</div>
