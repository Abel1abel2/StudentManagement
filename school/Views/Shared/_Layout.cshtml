<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - school</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/school.styles.css" asp-append-version="true" />
     <link rel="icon" type="image/png" href="/asset/icon.png" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white mb-3">
            <div class="container-fluid">
              
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
               <div class="navbar">
                
                   <div>
                         <a class="navbar-brand" asp-area="" style="color:white;" asp-controller="Home" asp-action="Index">
                             <img  src="/asset/icon.png" style="width:30px;height:30px;"/>
                         </a>
                   </div>
                   <div class="urlLink">
                          <div>
                         <a class="navbar-brand" asp-area="" style="color:white;" asp-controller="Student" asp-action="Index">Student</a>
                   </div>
                       <div>
                         <a class="navbar-brand" asp-area="" style="color:white;"  asp-controller="Course" asp-action="Index">Course</a>
                   </div>
                      <div>
                         <a class="navbar-brand" asp-area="" style="color:white;" asp-controller="Register" asp-action="Index">Register</a>
                   </div>
                       

                   </div>

                   <div>

                   
                   <partial name="_LoginPartial"/>
                       </div>
                 </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - school - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
